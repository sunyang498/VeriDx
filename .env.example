# 复制为 .env 后填写。任何 OpenAI 兼容接口都可用（智谱 / DeepSeek / Qwen / Moonshot）。

# ---- 主模型（诊断 / 讲解 / 盲解）----
LLM_MODE=auto
MODEL=glm-4.6
BASE_URL=https://open.bigmodel.cn/api/paas/v4
API_KEY=
TEMPERATURE=0.2

# ---- 第二模型（分支 B 闸 2 复核 + LLM-as-Judge，必须与主模型不同）----
# 未配置时：闸 2 判 unavailable → 只落 suspected_bad_answer_key=candidate；judge 不参与主表
SECOND_MODEL=
SECOND_BASE_URL=
SECOND_API_KEY=
SECOND_TEMPERATURE=0.2

# ---- 运行时 ----
VERIDX_DB_PATH=runtime/veridx.db
VERIDX_SEED_POLICY=fixed
